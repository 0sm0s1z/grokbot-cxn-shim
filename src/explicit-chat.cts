  else{const d=catalog.read(),c=options.journal.get(t),r=c.recent;const isScratch=options.scratchTarget?.(t)??false,mode=isScratch?'on (scratch text mode)':c.mode==='router'?'on (text mode)':'off (native)';text=`Global mode: ${options.journal.getGlobalMode()}; chat opt-in: ${c.mode==='router'||isScratch?'on':'off'}${isScratch?' (legacy scratch)':''}; effective router: ${mode}; model: ${c.model??'gpt-6-luna'}; origin: ${ORIGIN}. Model list: ${d.availability}, checked ${d.checkedAt===null?'never':new Date(d.checkedAt).toISOString()}, synced ${d.syncedAt===null?'never':new Date(d.syncedAt).toISOString()}${catalog.isStale(d)?' (stale)':''}${d.error?`; ${d.error}`:''}. Recent inference: ${r?`${r.success?'success':'failure'} at ${new Date(r.checkedAt).toISOString()}, ${r.durationMs} ms${r.usage?`, tokens ${JSON.stringify(r.usage)}`:''}`:'none recorded'}. Router mode is text-only; native tools and hidden instructions are unavailable.`}
