 try{const doc=JSON.parse(value);if(!doc||doc.type!=='doc'||!Array.isArray(doc.content)||Object.keys(doc).some(k=>k!=='type'&&k!=='content'))return false;
  const paragraphs:string[]=[];for(const node of doc.content){if(!node||node.type!=='paragraph'||Object.keys(node).some(k=>k!=='type'&&k!=='content')||!(node.content===undefined||Array.isArray(node.content)))return false;let line='';for(const leaf of node.content??[]){if(!leaf||leaf.type!=='text'||typeof leaf.text!=='string'||Object.keys(leaf).some(k=>k!=='type'&&k!=='text'))return false;line+=leaf.text}paragraphs.push(line)}return paragraphs.join('\n')===prompt;
 }catch{return false}
}
export function createExplicitChat(options:{journal:ReturnType<typeof createExplicitJournal>;ready:(t:Target)=>boolean;emit:(t:Target,r:readonly Row[])=>boolean;complete:(m:readonly {role:'user'|'assistant';content:string}[],s:AbortSignal,t?:Target)=>Promise<string>;now:()=>number;catalog?:ReturnType<typeof createCatalog>;scratchTarget?:(t:Target)=>boolean}){
