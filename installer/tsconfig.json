{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "composite": true,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.cts"
  ]
}
