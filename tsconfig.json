    "src/index.cts",
    "src/scratch.cts",
    "src/native-scratch.cts",
    "src/router.cts",
    "src/scratch-store.cts",
    "src/global-policy.cts",
    "src/explicit-chat.cts",
    "src/cxn-catalog.cts"
  ]
}
